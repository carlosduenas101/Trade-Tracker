# Copy this file to .env and replace the placeholder values with your real credentials.
# Never commit the .env file to version control.

# KCEX API credentials
# Obtain these from the KCEX account dashboard under API Management.
KCEX_API_KEY=your_key_here
KCEX_API_SECRET=your_secret_here

# SQLite database path (relative to the backend directory)
# To use a different database, supply a full SQLAlchemy connection string,
# e.g. postgresql://user:password@localhost:5432/trading_tracker
DATABASE_URL=sqlite:///./trading_tracker.db

# CORS allowed origins — comma-separated, no trailing slash
# Add your frontend dev server URL here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Only this user id may see or touch the fund pool (deny-all when unset)
POOL_OWNER_USER_ID=1

# ── Position Hub (backend/hub.py) ───────────────────────────────────────────
# Encrypts exchange API secrets at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_ENCRYPTION_KEY=
# KCEX browser snapshots (POST /hub/kcex/snapshot, header X-Hub-Token). Unset = denied.
HUB_INGEST_TOKEN=
HUB_INGEST_USER_ID=
# LBank private contract endpoint paths (copy from the contract API docs in your LBank account)
LBANK_POSITIONS_PATH=
LBANK_ORDERS_PATH=

# Hub phase 2: placing ladder entries on Bitunix. OFF unless HUB_TRADING_ENABLED=1.
# HUB_MAX_LADDER_MARGIN is required: a ladder whose total margin ($) is above it cannot be armed.
HUB_TRADING_ENABLED=0
HUB_MAX_LADDER_MARGIN=
